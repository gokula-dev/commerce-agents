{
  "services": {
    "frontend": {
      "root": "examples/logitech/storefront-web"
    },
    "backend": {
      "root": "examples",
      "entrypoint": "logitech.api.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
