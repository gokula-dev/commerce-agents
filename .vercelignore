# A local `vercel deploy` uploads the invoked directory as-is, ignoring .gitignore.
# Keep the upload lean and never ship the real synced Logitech data or the local venv.
.git
.venv
venv
node_modules
**/node_modules
.next
**/.next
__pycache__
**/__pycache__
*.pyc

# The raw Typesense export cache is never needed by the deployed app, but the
# *normalized* catalog.json/policies.json/orders.json in examples/logitech/data/ ARE
# shipped as part of this deployment (deliberately NOT excluded here) — see
# examples/logitech/README.md: search-dev.logitech.com is not reachable from Vercel's
# build infrastructure (403), so build-time regeneration from Typesense doesn't work.
# Refresh by rerunning poc/logitech_ingest/build_catalog.py locally and redeploying.
poc/logitech_ingest/raw
poc/logitech_ingest/.cache
